{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kehai",
  "version": "0.6.0",
  "identifier": "dev.purukitto.kehai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kehai",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Pulkit Sambhavi Singh",
    "copyright": "Copyright (c) 2026 Pulkit Sambhavi Singh",
    "category": "Utility",
    "homepage": "https://github.com/Purukitto/kehai",
    "licenseFile": "../LICENSE",
    "shortDescription": "A companion dashboard for a secondary display.",
    "longDescription": "Kehai is a dashboard for a small always-on secondary display. A Rust integration engine polls system telemetry, media, notifications and local agent token usage on background threads; the renderer lays widgets out on a configurable grid. Everything is read locally and stays on the machine. The only request it makes of its own is an optional check for new releases on GitHub.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MDNFQ0I1MUM4N0YxNDUKUldSRjhZY2N0ZXdEZG1iaUxtYVgrN2x5MXhUVWdaYW1UTFExL0oyR2daSVQ3amc4MGY3TnNUVWcK",
      "endpoints": ["https://github.com/Purukitto/kehai/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
