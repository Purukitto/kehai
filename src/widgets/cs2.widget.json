{
  "kehai": 1,
  "id": "cs2",
  "name": "Counter-Strike 2",
  "about": "Keeps the panel still while you play. When you die, at half time and between matches: the score, how each round went, your match and tonight’s.",
  "min": [2, 1],
  "source": {
    "kind": "valve-gsi",
    "game": "Counter-Strike 2",
    "short": "CS2",
    "icon": "M8 1.8v3.4M8 10.8v3.4M1.8 8h3.4M10.8 8h3.4M8 4.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 1 0 0-7.6",
    "steamApp": 730,
    "cfgDir": "game/csgo/cfg",
    "data": ["provider", "map", "map_round_wins", "round", "player_id", "player_match_stats"],
    "asks": [
      "The map, the mode, the round and the score",
      "Who won each round",
      "Your kills, assists, deaths and MVPs",
      "Whether the view is yours or a teammate’s"
    ],
    "never": ["Your health, money or weapons", "Other players’ figures", "Where anyone is", "When the bomb goes off"]
  },
  "match": {
    "in": "map.phase",
    "title": "{map.name} · {map.mode}",
    "phase": "map.phase",
    "over": ["gameover"],
    "still": {"path": "map.phase", "is": ["live"]}
  },
  "subject": {"self": "provider.steamid", "who": "player.steamid", "name": "player.name", "tag": "Out"},
  "readings": [
    {
      "id": "score",
      "display": "teams",
      "name": "Score and rounds",
      "about": "The score, the round, and who won each one so far.",
      "unless": {"path": "map.mode", "is": ["deathmatch", "gungameprogressive", "gungametrbomb", "custom"]},
      "you": "player.team",
      "sides": [
        {"label": "CT", "is": "CT", "score": "map.team_ct.score", "color": "second", "wins": "ct_", "hex": "#9fbbe3"},
        {"label": "T", "is": "T", "score": "map.team_t.score", "color": "first", "wins": "t_", "hex": "#e2c38e"}
      ],
      "round": {
        "path": "map.round",
        "add": 1,
        "of": {
          "path": "map.mode",
          "values": {"competitive": 24, "premier": 24, "wingman": 16, "scrimcomp2v2": 16}
        }
      },
      "history": "map.round_wins",
      "phase": [
        {
          "path": "map.phase",
          "labels": {"warmup": "Warmup", "intermission": "Half time", "gameover": "Match over"}
        },
        {
          "path": "round.phase",
          "labels": {"live": "Live", "freezetime": "Buy time", "over": "Round over"}
        }
      ]
    },
    {
      "id": "match",
      "display": "stats",
      "name": "Your match",
      "about": "Kills, assists, deaths and MVPs, yours even while you watch a teammate.",
      "own": true,
      "label": "Your match",
      "items": [
        {"label": "Kills", "short": "K", "value": "player.match_stats.kills"},
        {"label": "Assists", "short": "A", "value": "player.match_stats.assists"},
        {"label": "Deaths", "short": "D", "value": "player.match_stats.deaths"},
        {"label": "MVP", "short": "MVP", "value": "player.match_stats.mvps"}
      ]
    }
  ]
}
