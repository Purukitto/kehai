# Normalise line endings in the repository; check out native on Windows.
* text=auto eol=lf

*.rs      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.html    text eol=lf
*.toml    text eol=lf

*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets
*.png     binary
*.ico     binary
*.icns    binary
*.woff2   binary

# Lockfiles are generated; collapse them in diffs and reviews.
bun.lock           linguist-generated=true -diff
src-tauri/Cargo.lock linguist-generated=true -diff
